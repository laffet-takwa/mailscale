# MailScale local environment
# Copy to .env and adjust. Values here are placeholders only - never commit real secrets.

# --- Core ---
SPRING_PROFILES_ACTIVE=local
MAILSCALE_JWT_SECRET=change-me-in-production-use-a-long-random-string
MAILSCALE_JWT_EXPIRY_SECONDS=3600
MAILSCALE_DEMO_SEED_ENABLED=true

# --- Database (PostgreSQL is the default) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mailscale
SPRING_DATASOURCE_USERNAME=mailscale
SPRING_DATASOURCE_PASSWORD=mailscale-local
SPRING_FLYWAY_ENABLED=true

# --- Redis (rate limiting) ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EMAIL_COMMANDS=mailscale.emails.send
KAFKA_TOPIC_EMAIL_COMMANDS_DLQ=mailscale.emails.send.dlq
KAFKA_TOPIC_DELIVERY_EVENTS=mailscale.delivery.events
KAFKA_TOPIC_CAMPAIGN_COMMANDS=mailscale.campaigns.dispatch

# --- Email delivery ---
MAIL_PROVIDER=mock            # mock | smtp
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025           # Mailpit
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_DEFAULT=noreply@mailscale.local
MAIL_MAX_DELIVERY_ATTEMPTS=3
MAIL_RETRY_INITIAL_BACKOFF_MS=2000
MAIL_RETRY_MAX_BACKOFF_MS=60000
MAIL_RETRY_JITTER_RATIO=0.2
MAIL_RATE_LIMIT_PER_MINUTE=60

# --- AI assistant ---
AI_PROVIDER=mock              # mock | openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=1024
AI_ENABLED=true

# --- Worker ---
WORKER_CONCURRENCY=4
WORKER_POLL_TIMEOUT_MS=1000
WORKER_MAX_POLL_RECORDS=50

# --- SQL Server compatibility profile (optional, not required for local dev) ---
# SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=mailscale;encrypt=false
# SPRING_SQLSERVER_ENABLED=false
