        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mailscale_worker_delivery_duration_seconds_bucket[10m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Delivery latency percentiles",
      "type": "timeseries"
    },
    {
